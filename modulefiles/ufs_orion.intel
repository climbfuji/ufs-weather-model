#%Module

proc ModulesHelp {} {
  puts stderr "\tcit - loads modules required for building and running UFS Model on Orion/Intel"
}

module-whatis "loads UFS Model prerequisites for Orion/Intel"

module purge
module unuse /apps/modulefiles/core
module use /home/dheinzel/test_modulefiles/core

module use /work/noaa/gsd-hpcs/dheinzel/jcsda/spack-stack-20220131/envs_orion/install/modulefiles/Core
module load stack-intel/19.1.2
module load stack-intel-mpi/2019.8.254
module load stack-python/3.9.2

module load cmake/3.22.1
module load ufs_common

setenv CC mpiicc
setenv CXX mpiicpc
setenv FC mpiifort
setenv CMAKE_Platform orion.intel
