#%Module

proc ModulesHelp {} {
  puts stderr "\tcit - loads modules required for building and running UFS Model on Cheyenne/Intel"
}

module-whatis "loads UFS Model prerequisites for Cheyenne/Intel"

module purge
module unuse /glade/u/apps/ch/modulefiles/default/compilers
setenv MODULEPATH_ROOT /glade/p/ral/jntp/GMTB/tools/compiler_mpi_modules
module use /glade/p/ral/jntp/GMTB/tools/compiler_mpi_modules/compilers

module use /glade/work/heinzell/jedi-stack/spack-stack-20220131/envs_cheyenne/install/modulefiles/Core

module load stack-intel/2020.1.217
module load stack-intel-mpi/2019.7.217
module load stack-python/3.7.9

module load cmake/3.22.0
module load ufs_common

setenv CC mpiicc
setenv CXX mpiicpc
setenv FC mpiifort
setenv CMAKE_Platform cheyenne.intel
